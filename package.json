{
  "name": "checkoutv3",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma multi-tenant de checkout e orquestração de pagamentos.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "dev": "turbo dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:e2e": "pnpm --filter @checkout/web test:e2e",
    "typecheck": "turbo typecheck",
    "db:generate": "pnpm --filter @checkout/db db:generate",
    "db:migrate": "pnpm --filter @checkout/db db:migrate",
    "db:studio": "pnpm --filter @checkout/db db:studio",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "infra:up": "docker compose up -d"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "tsup": "^8.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
